{
  "name": "parent-playbook",
  "private": true,
  "description": "Parent Playbook. The web app has no build step; this file exists only for the iOS and Android shells (Capacitor).",
  "scripts": {
    "native:www": "node tools/native/build-www.mjs",
    "native:sync": "node tools/native/build-www.mjs && cap sync",
    "native:assets": "capacitor-assets generate --ios --android --assetPath native-assets --iconBackgroundColor '#0e5647' --iconBackgroundColorDark '#0e5647' --splashBackgroundColor '#0B1F1A' --splashBackgroundColorDark '#0B1F1A'",
    "native:ios": "node tools/native/build-www.mjs && cap sync ios && cap open ios",
    "native:android": "node tools/native/build-www.mjs && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@mediapipe/tasks-vision": "1.0.1",
    "@supabase/supabase-js": "2.117.2",
    "heic-to": "1.5.2",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2"
  }
}
