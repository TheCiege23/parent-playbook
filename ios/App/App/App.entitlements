<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode switches this to production when archiving for TestFlight / the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: invites, team codes and email sign-in links on playbookbp.com open the app.
	     Verified against https://playbookbp.com/.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:playbookbp.com</string>
	</array>
</dict>
</plist>
