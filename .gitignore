# dependencies
node_modules/

# local env / secrets — never commit these
# tools/sdk-sign.cjs refuses to WRITE a key in here, but a key can still arrive by being
# copied in. Belt and braces: a signing key must never be committed or sent to anyone.
*.pem
*.key
pp-sdk-signing-key*

# ...except the PUBLIC half, which is the point: a buyer needs it from somewhere other
# than the archive it verifies. This one file is published here deliberately.
!SIGNING-KEY.pub.pem


.env
.env.local
.env.*.local

# vercel link (machine-specific)
.vercel

# os / editor cruft
.DS_Store
Thumbs.db
*.log

.vercel
.env*

# supabase cli scratch (machine-specific link state)
supabase/.temp/

# Local reconstruction experiments may contain private body geometry and captures.
tools/reconstruction/runs/
__pycache__/

# Generated company SDK handoff packages; source remains in js/ and tools/.
tools/sdk-releases/

# Native app shells (Capacitor). www/ is generated from the web app by tools/native/build-www.mjs
# on every sync; the platform projects keep their own build output out via their own .gitignore.
www/
*.p8
*.jks
*.keystore
