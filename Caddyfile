# Static hosting for Parent Playbook on Railway.
#
# Replicates the two Vercel behaviours the app depends on:
#   cleanUrls: true  ->  /privacy serves privacy.html   (try_files below)
#   404.html         ->  served for anything unmatched  (handle_errors below)
#
# Railway injects $PORT; 8080 is the local fallback.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# playbookbp.com is canonical. Two other hosts reach this container and both
	# have to end up there:
	#   playbook.chimaura.com  the old home. Coach invite links carrying a team
	#                          code, password-reset emails, and anything a parent
	#                          bookmarked all point at it and are already in
	#                          inboxes — a 301 is the only thing that keeps them
	#                          working. Retire it on purpose, not by forgetting.
	#   www.playbookbp.com     so the www form is never a second, competing origin.
	#
	# A handle block rather than a bare redir: handle blocks run in source order,
	# so the redirect is guaranteed to win before try_files rewrites the path and
	# turns /privacy into a redirect to /privacy.html. The Railway-generated
	# *.up.railway.app host is deliberately not matched — health checks must not
	# be answered with a 301.
	@moved host playbook.chimaura.com www.playbookbp.com
	handle @moved {
		redir https://playbookbp.com{uri} permanent
	}

	handle {
		# cleanUrls. /terms -> terms.html, and a real file always wins over the guess.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# The service worker and the manifest must never be served stale — a cached sw.js
	# is how an installed phone keeps running last week's app forever. Everything else
	# is fingerprint-free too, so nothing here gets a long max-age; correctness beats
	# a few hundred milliseconds on a site this small.
	@nocache path /sw.js /manifest.webmanifest
	header @nocache Cache-Control "public, max-age=0, must-revalidate"

	@static path /css/* /js/* /assets/* /img/*
	header @static Cache-Control "public, max-age=0, must-revalidate"

	# iOS Universal Links and Android App Links. Apple fetches this file with no extension and
	# requires application/json; both must be served directly, never redirected.
	@applinks path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	header @applinks Content-Type "application/json"
	header @applinks Cache-Control "public, max-age=3600"

	# Caddy has no built-in type for .webmanifest, and a wrong type makes Chrome
	# ignore the manifest entirely — no install prompt, no screenshots.
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
