{
  "id": "/",
  "name": "Parent Playbook",
  "short_name": "Playbook",
  "description": "Help your young athlete grow — weekly plans, at-home activities, a private athlete journey, and parent guidance.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "prefer_related_applications": false,
  "categories": [
    "sports",
    "education",
    "lifestyle"
  ],
  "background_color": "#F6F2E9",
  "theme_color": "#0B1F1A",
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "This week",
      "short_name": "Week",
      "description": "Today's session and the week underneath",
      "url": "/?source=pwa#week",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Growth",
      "short_name": "Growth",
      "description": "Record a height or measurement",
      "url": "/?source=pwa#growth",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Journey",
      "short_name": "Journey",
      "description": "Log a game, milestone or photo",
      "url": "/?source=pwa#journey",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/img/screenshot-week.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "One thing today, the whole week underneath"
    },
    {
      "src": "/img/screenshot-journey.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Every game, milestone and photo, kept private"
    },
    {
      "src": "/img/screenshot-setup.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Set up in three minutes, built for their age and sport"
    },
    {
      "src": "/img/screenshot-wide-week.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The week, the next game and who can see your athlete, side by side"
    }
  ]
